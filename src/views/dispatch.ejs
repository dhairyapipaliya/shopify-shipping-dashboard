<!doctype html>
<html>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Dispatch · <%= order.order_number %></title>
  <link rel="stylesheet" href="/public/css/main.css" />
</head>
<body>
  <div class="app-shell">
    <%- include('partials/_nav', { activePage: 'orders' }) %>

    <div class="app-content">
      <header class="topbar topbar-actions">
        <button class="sidebar-toggle" type="button" aria-label="Toggle sidebar" onclick="document.body.classList.toggle('sidebar-open')">☰</button>
        <div>
          <p class="page-eyebrow">Dispatch</p>
          <h1>Rate Comparison</h1>
        </div>
        <a class="btn btn-soft" href="/orders">Back to Orders</a>
      </header>

      <main class="container dispatch-layout">
        <section class="card dispatch-summary-card">
          <div class="section-header">
            <h2>Order Summary</h2>
            <span class="badge badge-slate">#<%= order.order_number %></span>
          </div>
          <div class="dispatch-summary-grid">
            <div>
              <p class="muted small">Product</p>
              <p><strong><%= order.line_items.map((item) => item.title).join(', ') %></strong></p>
            </div>
            <div>
              <p class="muted small">Weight</p>
              <p><strong><%= order.package_details.weight_kg %> kg</strong></p>
            </div>
            <div>
              <p class="muted small">Dimensions</p>
              <p><strong><%= order.package_details.dimensions_cm.length %> × <%= order.package_details.dimensions_cm.width %> × <%= order.package_details.dimensions_cm.height %> cm</strong></p>
            </div>
            <div>
              <p class="muted small">Delivery Location</p>
              <p><strong><%= order.shipping_address.city %>, <%= order.shipping_address.province %> - <%= order.shipping_address.zip %></strong></p>
            </div>
          </div>
        </section>

        <% if (selectedRate) { %>
          <section class="card dispatch-selection-banner">
            <p><strong>Courier assigned:</strong> <%= selectedRate.provider_name %> via <%= selectedRate.source_name %> · <%= selectedRate.service_name %> (<%= selectedRate.service_type %>) · ₹<%= selectedRate.price %> · ETA <%= selectedRate.eta_days %> days.</p>
            <p class="muted small">Order status updated to <strong>Pickups &amp; Manifests</strong>. This now appears on Orders and Dashboard views.</p>
          </section>
        <% } %>
        <% if (errorCode === 'status-locked') { %>
          <section class="card">
            <p class="error">This order has already progressed beyond New. Re-assignment is currently disabled in this workflow.</p>
          </section>
        <% } %>

        <section class="card">
          <div class="section-header">
            <h2>Courier Rate Options</h2>
            <p class="muted small">Column comparison ready for direct and aggregator API rate feeds.</p>
          </div>

          <div class="dispatch-rate-comparison">
            <% rates.forEach((rate) => { %>
              <article class="dispatch-rate-column <%= selectedRateId === rate.option_id ? 'is-selected' : '' %>">
                <div class="dispatch-rate-column-head">
                  <div>
                    <p class="muted small">Provider</p>
                    <h3><%= rate.provider_name %></h3>
                    <p class="muted small">Source: <strong><%= rate.source_name %></strong></p>
                  </div>
                  <div class="dispatch-rate-column-tags">
                    <% rate.tags.forEach((tag) => { %>
                      <span class="badge <%= tag === 'cheapest' ? 'badge-green' : tag === 'fastest' ? 'badge-blue' : 'badge-slate' %>"><%= tag.charAt(0).toUpperCase() + tag.slice(1) %></span>
                    <% }) %>
                  </div>
                </div>

                <div class="dispatch-rate-column-metrics">
                  <div>
                    <p class="muted small">Service</p>
                    <p class="dispatch-rate-value"><%= rate.service_name %></p>
                  </div>
                  <div>
                    <p class="muted small">Service Type</p>
                    <p class="dispatch-rate-value"><%= rate.service_type %></p>
                  </div>
                  <div>
                    <p class="muted small">Rate</p>
                    <p class="dispatch-rate-value">₹<%= rate.price %></p>
                  </div>
                  <div>
                    <p class="muted small">ETA</p>
                    <p class="dispatch-rate-value"><%= rate.eta_days %> days</p>
                  </div>
                </div>

                <% if (order.workflow_status === 'new') { %>
                  <form method="post" action="/dispatch/<%= encodeURIComponent(order.order_id) %>/select">
                    <input type="hidden" name="rateId" value="<%= rate.option_id %>" />
                    <button class="btn btn-block" type="submit"><%= selectedRateId === rate.option_id ? 'Selected' : 'Select Courier' %></button>
                  </form>
                <% } else { %>
                  <p class="muted small">Courier selection is locked because this order is no longer in the <strong>New</strong> stage.</p>
                <% } %>
              </article>
            <% }) %>
          </div>
        </section>
      </main>
    </div>
  </div>
</body>
</html>
