<!doctype html>
<html>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Orders</title>
  <link rel="stylesheet" href="/public/css/main.css" />
</head>
<body>
  <div class="app-shell">
    <%- include('partials/_nav', { activePage: 'orders' }) %>

    <div class="app-content">
      <header class="topbar topbar-actions">
        <button class="sidebar-toggle" type="button" aria-label="Toggle sidebar" onclick="document.body.classList.toggle('sidebar-open')">☰</button>
        <div>
          <p class="page-eyebrow">Management</p>
          <h1>Orders</h1>
        </div>
        <form method="post" action="/orders/sync">
          <button class="btn" type="submit">Sync Shopify Orders</button>
        </form>
      </header>

      <main class="container">
        <section class="card">
          <div class="table-wrap">
            <table>
              <thead><tr><th>Order</th><th>Customer</th><th>Weight(g)</th><th>Pincode</th><th>Payment</th><th>Action</th></tr></thead>
              <tbody>
              <% orders.forEach((order) => { %>
              <% const latestShipment = order.shipments[0]; %>
              <tr>
                <td><%= order.orderNumber %></td>
                <td><%= order.customerName %></td>
                <td><%= order.totalWeightGrams %></td>
                <td><%= order.pincode %></td>
                <td><span class="badge <%= order.paymentMode === 'COD' ? 'badge-amber' : 'badge-blue' %>"><%= order.paymentMode %></span></td>
                <td>
                  <% if (latestShipment) { %>
                    <div class="row-stack">
                      <span class="badge badge-green">Booked</span>
                      <span class="muted small">Shipment <%= latestShipment.status %></span>
                    </div>
                  <% } else { %>
                    <a class="link" href="/orders/<%= order.id %>/quotes">Compare Cheapest Delhivery Option</a>
                  <% } %>
                </td>
              </tr>
              <% }) %>
              </tbody>
            </table>
          </div>
        </section>
      </main>
    </div>
  </div>
</body>
</html>
