<!doctype html>
<html>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Orders</title>
  <link rel="stylesheet" href="/public/css/main.css" />
</head>
<body>
  <div class="app-shell">
    <%- include('partials/_nav', { activePage: 'orders' }) %>

    <div class="app-content">
      <header class="topbar topbar-actions">
        <button class="sidebar-toggle" type="button" aria-label="Toggle sidebar" onclick="document.body.classList.toggle('sidebar-open')">☰</button>
        <div>
          <p class="page-eyebrow">Management</p>
          <h1>Orders</h1>
        </div>
        <form method="post" action="/orders/sync">
          <button class="btn" type="submit">Sync Shopify Orders</button>
        </form>
      </header>

      <main class="container">
        <section class="card">
          <div class="orders-toolbar">
            <form method="get" action="/orders" class="orders-filter-form">
              <label for="status" class="small">Filter by Status</label>
              <div class="orders-filter-controls">
                <div class="custom-select" data-custom-select>
                  <select id="status" name="status" onchange="this.form.submit()">
                    <% statusOptions.forEach((option) => { %>
                      <option value="<%= option.value %>" <%= selectedStatus === option.value ? 'selected' : '' %>><%= option.label %></option>
                    <% }) %>
                  </select>
                  <button
                    class="custom-select-trigger"
                    type="button"
                    aria-haspopup="listbox"
                    aria-expanded="false"
                    aria-controls="status-options"
                  >
                    <span class="custom-select-value">All</span>
                    <span class="custom-select-arrow" aria-hidden="true"></span>
                  </button>
                  <ul class="custom-select-dropdown" id="status-options" role="listbox" hidden></ul>
                </div>
                <noscript><button class="btn btn-sm" type="submit">Apply</button></noscript>
              </div>
            </form>
          </div>

          <% if (!orders.length) { %>
            <div class="empty-state">
              <p><strong>No orders found for selected status.</strong></p>
              <p class="muted small">Try choosing a different status filter or sync fresh orders.</p>
            </div>
          <% } else { %>
          <div class="table-wrap">
            <table class="orders-operations-table">
              <thead>
                <tr>
                  <th>Order Date</th>
                  <th>Order Details</th>
                  <th>Product Details</th>
                  <th>Package Details</th>
                  <th>Payment</th>
                  <th>Shipping Details</th>
                  <th>Status</th>
                  <th>Action</th>
                </tr>
              </thead>
              <tbody>
              <% orders.forEach((order) => { %>
              <tr>
                <td>
                  <div class="cell-stack">
                    <strong><%= order.orderDateLabel %></strong>
                    <span class="muted small"><%= order.orderTimeLabel %></span>
                  </div>
                </td>
                <td>
                  <div class="cell-stack">
                    <strong><%= order.orderNumber %></strong>
                    <span class="muted small">Ref: <%= order.referenceId %></span>
                  </div>
                </td>
                <td>
                  <div class="cell-stack">
                    <strong><%= order.productsSummary %></strong>
                    <span class="muted small">SKU: <%= order.skuSummary %></span>
                    <span class="muted small">Qty: <%= order.quantityTotal %></span>
                  </div>
                </td>
                <td>
                  <div class="cell-stack">
                    <span><strong><%= order.weightKg %> kg</strong></span>
                    <span class="muted small"><%= order.dimensionsLabel %> cm</span>
                  </div>
                </td>
                <td>
                  <div class="cell-stack">
                    <strong>₹<%= order.paymentAmount.toLocaleString('en-IN') %></strong>
                    <span class="badge <%= order.paymentType === 'COD' ? 'badge-amber' : 'badge-blue' %>"><%= order.paymentType %></span>
                  </div>
                </td>
                <td>
                  <div class="cell-stack">
                    <strong><%= order.shippingName %></strong>
                    <span class="muted small"><%= order.shippingAddress %></span>
                    <span class="muted small"><%= order.cityStatePincode %></span>
                  </div>
                </td>
                <td>
                  <span class="badge <%= order.operationalStatusBadgeClass %>"><%= order.operationalStatusLabel %></span>
                </td>
                <td>
                  <% if (order.latestShipment) { %>
                    <div class="row-stack">
                      <span class="badge <%= order.operationalStatusBadgeClass %>"><%= order.operationalStatusLabel %></span>
                      <span class="muted small">Shipment <%= order.latestShipment.status %></span>
                    </div>
                  <% } else if (order.source === 'db') { %>
                    <a class="link" href="/orders/<%= order.id %>/quotes">Assign Courier</a>
                  <% } else { %>
                    <button class="btn btn-sm" type="button" disabled>Assign Courier</button>
                    <p class="muted small">Demo order</p>
                  <% } %>
                </td>
              </tr>
              <% }) %>
              </tbody>
            </table>
          </div>

          <div class="orders-status-pills" aria-label="Quick status filters">
            <% statusOptions.forEach((option) => { %>
              <a
                href="/orders?status=<%= option.value %>"
                class="status-pill <%= selectedStatus === option.value ? 'is-active' : '' %>"
              ><%= option.label %></a>
            <% }) %>
          </div>
          <% } %>
        </section>
      </main>
    </div>
  </div>
  <script src="/public/js/customSelect.js"></script>
</body>
</html>
