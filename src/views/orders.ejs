<!doctype html>
<html>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Orders</title>
  <link rel="stylesheet" href="/public/css/main.css" />
</head>
<body>
  <div class="app-shell">
    <%- include('partials/_nav', { activePage: 'orders' }) %>

    <div class="app-content">
      <header class="topbar topbar-actions">
        <button class="sidebar-toggle" type="button" aria-label="Toggle sidebar" onclick="document.body.classList.toggle('sidebar-open')">☰</button>
        <div>
          <p class="page-eyebrow">Management</p>
          <h1>Orders</h1>
        </div>
        <form method="post" action="/orders/sync">
          <button class="btn" type="submit">Sync Shopify Orders</button>
        </form>
      </header>

      <main class="container">
        <section class="card">
          <% if (updatedOrder) { %>
            <div class="dispatch-selection-banner">
              <p><strong>Order updated:</strong> shared frontend order state refreshed for status, actions, and counts.</p>
            </div>
          <% } %>
          <div class="orders-toolbar">
            <div class="orders-workflow" aria-label="Operational workflow status filters">
              <% statusGroups.forEach((group) => { %>
                <section class="workflow-group" aria-label="<%= group.title %>">
                  <p class="workflow-group-title"><%= group.title %></p>
                  <div class="workflow-segmented" role="tablist" aria-label="<%= group.title %> statuses">
                    <% group.statuses.forEach((statusValue) => {
                      const option = statusOptions.find((statusOption) => statusOption.value === statusValue);
                      if (!option) return;
                    %>
                      <a
                        href="/orders?status=<%= option.value %>"
                        class="workflow-tab <%= selectedStatus === option.value ? 'is-active' : '' %>"
                        role="tab"
                        aria-selected="<%= selectedStatus === option.value ? 'true' : 'false' %>"
                      >
                        <span class="workflow-tab-label"><%= option.label %></span>
                        <span class="workflow-count-badge"><%= statusCounts[option.value] ?? 0 %></span>
                      </a>
                    <% }) %>
                  </div>
                </section>
              <% }) %>
            </div>
          </div>

          <div class="orders-content-shell <%= !orders.length ? 'is-empty' : '' %>">
            <% if (!orders.length) { %>
              <div class="empty-state orders-empty-state">
                <div class="empty-state-content">
                  <p><strong>No orders in this stage yet.</strong></p>
                  <p class="muted small">Try choosing a different status filter, or sync fresh orders from Shopify.</p>
                </div>
              </div>
            <% } else { %>
            <div class="table-wrap">
              <table class="orders-operations-table">
              <thead>
                <tr>
                  <th>Order Date</th>
                  <th>Order Details</th>
                  <th>Product Details</th>
                  <th>Package Details</th>
                  <th>Payment</th>
                  <th>Shipping Details</th>
                  <th>Courier Selection</th>
                  <th>Tracking Info</th>
                  <th>Status</th>
                  <th>Action</th>
                </tr>
              </thead>
              <tbody>
              <% orders.forEach((order) => { %>
              <tr>
                <td>
                  <div class="cell-stack">
                    <strong><%= order.orderDateLabel %></strong>
                    <span class="muted small"><%= order.orderTimeLabel %></span>
                  </div>
                </td>
                <td>
                  <div class="cell-stack">
                    <strong><%= order.orderNumber %></strong>
                    <span class="muted small">Ref: <%= order.referenceId %></span>
                  </div>
                </td>
                <td>
                  <div class="cell-stack">
                    <strong><%= order.productsSummary %></strong>
                    <span class="muted small">SKU: <%= order.skuSummary %></span>
                    <span class="muted small">Qty: <%= order.quantityTotal %></span>
                  </div>
                </td>
                <td>
                  <div class="cell-stack">
                    <div class="inline-split">
                      <span><strong><%= order.weightKg %> kg</strong></span>
                      <% if (order.operationalStatus === 'new') { %>
                      <button
                        class="icon-btn"
                        type="button"
                        data-package-editor
                        data-order-id="<%= order.id %>"
                        data-package-mode="<%= order.packageMode %>"
                        data-total-weight="<%= order.weightKg %>"
                        data-boxes="<%= encodeURIComponent(JSON.stringify(order.packageBoxes)) %>"
                        title="Edit package details"
                        aria-label="Edit package details"
                      >✎</button>
                      <% } %>
                    </div>
                    <span class="muted small"><%= order.dimensionsLabel %> cm</span>
                    <span class="muted small"><%= order.boxCount %> boxes · <%= order.packageBoxes.length %> package row<%= order.packageBoxes.length === 1 ? '' : 's' %> · <%= order.packageMode === 'MULTI_PACKAGE_B2B' ? 'Multiple Package (B2B)' : 'Single Package (B2C)' %></span>
                  </div>
                </td>
                <td>
                  <div class="cell-stack">
                    <strong>₹<%= order.paymentAmount.toLocaleString('en-IN') %></strong>
                    <span class="badge <%= order.paymentType === 'COD' ? 'badge-amber' : 'badge-blue' %>"><%= order.paymentType %></span>
                  </div>
                </td>
                <td>
                  <div class="cell-stack">
                    <strong><%= order.shippingName %></strong>
                    <span class="muted small"><%= order.shippingAddress %></span>
                    <span class="muted small"><%= order.cityStatePincode %></span>
                  </div>
                </td>
                <td>
                  <div class="cell-stack">
                    <strong><%= order.selectedCourierSummary %></strong>
                    <span class="muted small"><%= order.selectedCourierMeta %></span>
                  </div>
                </td>
                <td>
                  <% if (order.operationalStatus !== 'new') { %>
                    <div class="tracking-block">
                      <span class="muted small"><strong><%= order.trackingCourierName %></strong> · <%= order.trackingServiceName %></span>
                      <span class="tracking-awb">
                        AWB: <span data-awb-value><%= order.awbNumber %></span>
                        <button type="button" class="copy-awb-btn" data-copy-awb="<%= order.awbNumber %>">Copy</button>
                      </span>
                      <span class="muted small">Status: <%= order.trackingStatusText %></span>
                    </div>
                  <% } else { %>
                    <span class="muted small">Tracking info appears after courier assignment.</span>
                  <% } %>
                </td>
                <td>
                  <span class="badge <%= order.operationalStatusBadgeClass %>"><%= order.operationalStatusLabel %></span>
                </td>
                <td class="orders-action-cell">
                  <% if (order.latestShipment) { %>
                    <div class="row-stack">
                      <span class="badge <%= order.operationalStatusBadgeClass %>"><%= order.operationalStatusLabel %></span>
                      <span class="muted small">Shipment <%= order.latestShipment.status %></span>
                    </div>
                  <% } else if (order.operationalStatus === 'pickupsAndManifests') { %>
                    <div class="row-stack action-row-stack">
                      <form method="post" action="/orders/<%= encodeURIComponent(order.id) %>/print-label">
                        <button class="btn btn-sm btn-soft action-btn-equal" type="submit">Print Label</button>
                      </form>
                      <form method="post" action="/orders/<%= encodeURIComponent(order.id) %>/manifest">
                        <button class="btn btn-sm btn-soft action-btn-equal" type="submit">Manifest</button>
                      </form>
                    </div>
                  <% } else if (order.operationalStatus !== 'new') { %>
                    <span class="muted small">No action</span>
                  <% } else if (order.source === 'db') { %>
                    <a class="link" href="/orders/<%= order.id %>/quotes">Assign Courier</a>
                  <% } else { %>
                    <div class="new-order-actions">
                      <a class="btn btn-sm btn-action-main" href="/dispatch/<%= encodeURIComponent(order.id) %>">Assign Courier</a>
                      <details class="action-menu">
                        <summary class="icon-btn" aria-label="Order actions">▾</summary>
                        <div class="action-menu-list">
                          <form method="post" action="/orders/<%= encodeURIComponent(order.id) %>/actions"><input type="hidden" name="action" value="editOrder" /><button type="submit" class="action-menu-item">Edit Order</button></form>
                          <form method="post" action="/orders/<%= encodeURIComponent(order.id) %>/actions"><input type="hidden" name="action" value="archive" /><button type="submit" class="action-menu-item">Archive Order</button></form>
                          <form method="post" action="/orders/<%= encodeURIComponent(order.id) %>/actions"><input type="hidden" name="action" value="changePickupAddress" /><button type="submit" class="action-menu-item">Change Pickup Address</button></form>
                          <form method="post" action="/orders/<%= encodeURIComponent(order.id) %>/actions"><input type="hidden" name="action" value="clone" /><button type="submit" class="action-menu-item">Clone Order</button></form>
                          <form method="post" action="/orders/<%= encodeURIComponent(order.id) %>/actions" onsubmit="return confirm('Delete this order? This action cannot be undone.');"><input type="hidden" name="action" value="delete" /><button type="submit" class="action-menu-item danger">Delete Order</button></form>
                        </div>
                      </details>
                    </div>
                  <% } %>
                </td>
              </tr>
              <% }) %>
              </tbody>
              </table>
            </div>
            <% } %>
          </div>
        </section>
      </main>
    </div>
  </div>

  <dialog id="packageEditDialog" class="package-modal">
    <form method="post" id="packageEditForm" class="package-form">
      <h3>Edit package details</h3>
      <input type="hidden" name="orderId" id="packageOrderId" />
      <label>
        Package type
        <select name="packageMode" id="packageModeSelect">
          <option value="SINGLE_PACKAGE_B2C">Single Package (B2C)</option>
          <option value="MULTI_PACKAGE_B2B">Multiple Package (B2B)</option>
        </select>
      </label>
      <div class="package-weight-readonly">
        <p class="muted small">Total shipment weight</p>
        <p><strong><span id="totalWeightKg">0.00</span> kg</strong></p>
      </div>
      <div class="box-rows" id="boxRows"></div>
      <div class="modal-footer">
        <button type="button" class="btn btn-sm btn-soft" id="addBoxBtn">Add box group</button>
        <div class="modal-footer-right">
          <button type="button" class="btn btn-sm btn-soft" id="closePackageModal">Cancel</button>
          <button type="submit" class="btn btn-sm">Save package</button>
        </div>
      </div>
    </form>
  </dialog>

  <div id="awbCopyToast" class="copy-toast" role="status" aria-live="polite"></div>

  <script>
    (() => {
      const dialog = document.getElementById('packageEditDialog');
      const form = document.getElementById('packageEditForm');
      const boxRows = document.getElementById('boxRows');
      const addBoxBtn = document.getElementById('addBoxBtn');
      const packageModeSelect = document.getElementById('packageModeSelect');
      const totalWeightValue = document.getElementById('totalWeightKg');
      const orderIdInput = document.getElementById('packageOrderId');
      const closeBtn = document.getElementById('closePackageModal');
      const toast = document.getElementById('awbCopyToast');

      const defaultGroup = { no_of_boxes: 1, per_box_weight_kg: 0.5, length_cm: 20, width_cm: 14, height_cm: 7 };
      const toSafeNumber = (value, fallback = 0) => Number.isFinite(Number(value)) ? Number(value) : fallback;
      const readCurrentRows = () => Array.from(boxRows.querySelectorAll('.box-row')).map((row) => ({
        no_of_boxes: Math.max(1, Math.round(toSafeNumber(row.querySelector('[name="boxQuantity"]').value, 1))),
        per_box_weight_kg: Math.max(0, toSafeNumber(row.querySelector('[name="boxPerWeightKg"]').value, 0)),
        length_cm: Math.max(0, Math.round(toSafeNumber(row.querySelector('[name="boxLengthCm"]').value, 0))),
        width_cm: Math.max(0, Math.round(toSafeNumber(row.querySelector('[name="boxWidthCm"]').value, 0))),
        height_cm: Math.max(0, Math.round(toSafeNumber(row.querySelector('[name="boxHeightCm"]').value, 0)))
      }));

      const updateTotalWeight = () => {
        const totalWeight = readCurrentRows().reduce((sum, row) => sum + (row.no_of_boxes * row.per_box_weight_kg), 0);
        totalWeightValue.textContent = totalWeight.toFixed(2);
      };

      const renderBoxRow = (box, index, allowRemove) => {
        const row = document.createElement('div');
        row.className = 'box-row';
        row.innerHTML = `
          <p class="small muted">Package group ${index + 1}</p>
          <div class="box-grid">
            <label>No. of box<input required type="number" min="1" step="1" name="boxQuantity" value="${box.no_of_boxes || 1}" /></label>
            <label>Weight / box (kg)<input required type="number" min="0.01" step="0.01" name="boxPerWeightKg" value="${box.per_box_weight_kg || ''}" /></label>
            <label>Length (cm)<input required type="number" min="1" step="1" name="boxLengthCm" value="${box.length_cm || ''}" /></label>
            <label>Width (cm)<input required type="number" min="1" step="1" name="boxWidthCm" value="${box.width_cm || ''}" /></label>
            <label>Height (cm)<input required type="number" min="1" step="1" name="boxHeightCm" value="${box.height_cm || ''}" /></label>
          </div>
          ${allowRemove ? '<button class="btn btn-sm btn-soft remove-box" type="button">Remove</button>' : ''}
        `;
        const removeBtn = row.querySelector('.remove-box');
        if (removeBtn) {
          removeBtn.addEventListener('click', () => {
            row.remove();
            refreshBoxRows();
          });
        }
        row.querySelectorAll('input').forEach((input) => input.addEventListener('input', updateTotalWeight));
        boxRows.appendChild(row);
      };

      const refreshBoxRows = () => {
        const isMulti = packageModeSelect.value === 'MULTI_PACKAGE_B2B';
        const boxes = readCurrentRows();
        boxRows.innerHTML = '';
        const nextBoxes = boxes.length ? boxes : [defaultGroup];
        (isMulti ? nextBoxes : [{ ...nextBoxes[0], no_of_boxes: 1 }]).forEach((box, index, arr) => renderBoxRow(box, index, isMulti && arr.length > 1));
        addBoxBtn.disabled = !isMulti;
        updateTotalWeight();
      };

      document.querySelectorAll('[data-package-editor]').forEach((button) => {
        button.addEventListener('click', () => {
          const orderId = button.getAttribute('data-order-id');
          const packageMode = button.getAttribute('data-package-mode');
          const totalWeight = button.getAttribute('data-total-weight');
          const boxes = JSON.parse(decodeURIComponent(button.getAttribute('data-boxes') || '%5B%5D'));

          orderIdInput.value = orderId;
          form.action = `/orders/${encodeURIComponent(orderId)}/package`;
          packageModeSelect.value = packageMode;
          totalWeightValue.textContent = Number(totalWeight || 0).toFixed(2);

          boxRows.innerHTML = '';
          (boxes.length ? boxes : [{ ...defaultGroup, per_box_weight_kg: Number(totalWeight) || 0.5 }]).forEach((box, index, arr) => {
            const isMulti = packageMode === 'MULTI_PACKAGE_B2B';
            renderBoxRow(box, index, isMulti && arr.length > 1);
          });

          refreshBoxRows();
          dialog.showModal();
        });
      });

      packageModeSelect.addEventListener('change', refreshBoxRows);
      addBoxBtn.addEventListener('click', () => {
        if (packageModeSelect.value !== 'MULTI_PACKAGE_B2B') return;
        renderBoxRow(defaultGroup, boxRows.children.length, true);
        refreshBoxRows();
      });

      closeBtn.addEventListener('click', () => dialog.close());

      document.querySelectorAll('[data-copy-awb]').forEach((button) => {
        button.addEventListener('click', async () => {
          const awb = button.getAttribute('data-copy-awb') || '';
          if (!awb || awb === 'Pending') return;
          try {
            await navigator.clipboard.writeText(awb);
            toast.textContent = `AWB ${awb} copied`;
            toast.classList.add('show');
            setTimeout(() => toast.classList.remove('show'), 1400);
          } catch {
            toast.textContent = 'Unable to copy AWB';
            toast.classList.add('show');
            setTimeout(() => toast.classList.remove('show'), 1400);
          }
        });
      });
    })();
  </script>
</body>
</html>
