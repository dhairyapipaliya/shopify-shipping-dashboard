<!doctype html>
<html>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Orders</title>
  <link rel="stylesheet" href="/public/css/main.css" />
</head>
<body>
  <div class="app-shell">
    <%- include('partials/_nav', { activePage: 'orders' }) %>

    <div class="app-content">
      <header class="topbar topbar-actions">
        <button class="sidebar-toggle" type="button" aria-label="Toggle sidebar" onclick="document.body.classList.toggle('sidebar-open')">☰</button>
        <div>
          <p class="page-eyebrow">Management</p>
          <h1>Orders</h1>
        </div>
        <form method="post" action="/orders/sync">
          <button class="btn" type="submit">Sync Shopify Orders</button>
        </form>
      </header>

      <main class="container">
        <section class="card">
          <% if (updatedOrder) { %>
            <div class="dispatch-selection-banner">
              <p><strong>Dispatch updated:</strong> Order moved to <strong>Pickups &amp; Manifests</strong>. Label and manifest actions are now available.</p>
            </div>
          <% } %>
          <div class="orders-toolbar">
            <div class="orders-workflow" aria-label="Operational workflow status filters">
              <% statusGroups.forEach((group) => { %>
                <section class="workflow-group" aria-label="<%= group.title %>">
                  <p class="workflow-group-title"><%= group.title %></p>
                  <div class="workflow-segmented" role="tablist" aria-label="<%= group.title %> statuses">
                    <% group.statuses.forEach((statusValue) => {
                      const option = statusOptions.find((statusOption) => statusOption.value === statusValue);
                      if (!option) return;
                    %>
                      <a
                        href="/orders?status=<%= option.value %>"
                        class="workflow-tab <%= selectedStatus === option.value ? 'is-active' : '' %>"
                        role="tab"
                        aria-selected="<%= selectedStatus === option.value ? 'true' : 'false' %>"
                      ><%= option.label %></a>
                    <% }) %>
                  </div>
                </section>
              <% }) %>
            </div>
          </div>

          <% if (!orders.length) { %>
            <div class="empty-state">
              <p><strong>No orders found for selected status.</strong></p>
              <p class="muted small">Try choosing a different status filter or sync fresh orders.</p>
            </div>
          <% } else { %>
          <div class="table-wrap">
            <table class="orders-operations-table">
              <thead>
                <tr>
                  <th>Order Date</th>
                  <th>Order Details</th>
                  <th>Product Details</th>
                  <th>Package Details</th>
                  <th>Payment</th>
                  <th>Shipping Details</th>
                  <th>Courier Selection</th>
                  <th>Status</th>
                  <th>Action</th>
                </tr>
              </thead>
              <tbody>
              <% orders.forEach((order) => { %>
              <tr>
                <td>
                  <div class="cell-stack">
                    <strong><%= order.orderDateLabel %></strong>
                    <span class="muted small"><%= order.orderTimeLabel %></span>
                  </div>
                </td>
                <td>
                  <div class="cell-stack">
                    <strong><%= order.orderNumber %></strong>
                    <span class="muted small">Ref: <%= order.referenceId %></span>
                  </div>
                </td>
                <td>
                  <div class="cell-stack">
                    <strong><%= order.productsSummary %></strong>
                    <span class="muted small">SKU: <%= order.skuSummary %></span>
                    <span class="muted small">Qty: <%= order.quantityTotal %></span>
                  </div>
                </td>
                <td>
                  <div class="cell-stack">
                    <span><strong><%= order.weightKg %> kg</strong></span>
                    <span class="muted small"><%= order.dimensionsLabel %> cm</span>
                  </div>
                </td>
                <td>
                  <div class="cell-stack">
                    <strong>₹<%= order.paymentAmount.toLocaleString('en-IN') %></strong>
                    <span class="badge <%= order.paymentType === 'COD' ? 'badge-amber' : 'badge-blue' %>"><%= order.paymentType %></span>
                  </div>
                </td>
                <td>
                  <div class="cell-stack">
                    <strong><%= order.shippingName %></strong>
                    <span class="muted small"><%= order.shippingAddress %></span>
                    <span class="muted small"><%= order.cityStatePincode %></span>
                  </div>
                </td>
                <td>
                  <div class="cell-stack">
                    <strong><%= order.selectedCourierSummary %></strong>
                    <span class="muted small"><%= order.selectedCourierMeta %></span>
                  </div>
                </td>
                <td>
                  <span class="badge <%= order.operationalStatusBadgeClass %>"><%= order.operationalStatusLabel %></span>
                </td>
                <td>
                  <% if (order.latestShipment) { %>
                    <div class="row-stack">
                      <span class="badge <%= order.operationalStatusBadgeClass %>"><%= order.operationalStatusLabel %></span>
                      <span class="muted small">Shipment <%= order.latestShipment.status %></span>
                    </div>
                  <% } else if (order.operationalStatus === 'pickupsAndManifests') { %>
                    <div class="row-stack">
                      <form method="post" action="/orders/<%= encodeURIComponent(order.id) %>/print-label">
                        <button class="btn btn-sm btn-soft" type="submit">Print Label</button>
                      </form>
                      <form method="post" action="/orders/<%= encodeURIComponent(order.id) %>/manifest">
                        <button class="btn btn-sm btn-soft" type="submit">Manifest</button>
                      </form>
                    </div>
                  <% } else if (order.operationalStatus !== 'new') { %>
                    <span class="muted small">No action</span>
                  <% } else if (order.source === 'db') { %>
                    <a class="link" href="/orders/<%= order.id %>/quotes">Assign Courier</a>
                  <% } else { %>
                    <a class="link" href="/dispatch/<%= encodeURIComponent(order.id) %>">Assign Courier</a>
                  <% } %>
                </td>
              </tr>
              <% }) %>
              </tbody>
            </table>
          </div>
          <% } %>
        </section>
      </main>
    </div>
  </div>
</body>
</html>
