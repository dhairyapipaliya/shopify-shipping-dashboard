<!doctype html>
<html><head><meta charset="utf-8" /><title>Orders</title><link rel="stylesheet" href="/public/css/main.css" /></head>
<body>
  <%- include('/partials/nav') %>
  <main class="container">
    <div class="header-row"><h1>Shopify Orders</h1><form method="post" action="/orders/sync"><button>Sync Shopify Orders</button></form></div>
    <div class="card-grid">
      <% orders.forEach((order) => { %>
        <article class="card">
          <h3><%= order.orderNumber %> · <%= order.customerName %></h3>
          <p>Pincode: <%= order.pincode %> | Weight: <%= order.totalWeightGrams %> g</p>
          <p>Dimensions: <%= order.lengthCm %> × <%= order.widthCm %> × <%= order.heightCm %> cm</p>
          <p>Order value: ₹<%= order.orderValue %></p>
          <a class="btn-link" href="/orders/<%= order.id %>/dispatch">Open Dispatch Review</a>
        </article>
      <% }) %>
    </div>
  </main>
</body></html>
