<!doctype html>
<html><head><meta charset="utf-8" /><title>Orders</title><link rel="stylesheet" href="/public/css/main.css" /></head>
<body>
  <% include _nav %>
  <main class="container">
    <h1>Orders</h1>
    <form method="post" action="/orders/sync"><button type="submit">Sync Shopify Orders</button></form>
    <table>
      <thead><tr><th>Order</th><th>Customer</th><th>Weight(g)</th><th>Pincode</th><th>Payment</th><th>Action</th></tr></thead>
      <tbody>
      <% orders.forEach((order) => { %>
      <tr>
        <td><%= order.orderNumber %></td>
        <td><%= order.customerName %></td>
        <td><%= order.totalWeightGrams %></td>
        <td><%= order.pincode %></td>
        <td><%= order.paymentMode %></td>
        <td><a href="/orders/<%= order.id %>/quotes">Compare Cheapest Delhivery Option</a></td>
      </tr>
      <% }) %>
      </tbody>
    </table>
  </main>
</body></html>
