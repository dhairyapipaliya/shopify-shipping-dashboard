<!doctype html>
<html><head><meta charset="utf-8" /><title>Dashboard</title><link rel="stylesheet" href="/public/css/main.css" /></head>
<body>
<%- include('partials/_nav') %>
  <main class="container">
    <h1>Shipping Admin Dashboard</h1>
    <p>Current recommendation mode: <strong>Cheapest Delhivery option only</strong> (Direct vs Shipmozo Delhivery).</p>
    <section class="grid">
      <article class="card"><h3>Total Orders</h3><p><%= ordersCount %></p></article>
      <article class="card"><h3>Total Shipments</h3><p><%= shipmentsCount %></p></article>
    </section>
    <h2>Latest Orders</h2>
    <table><thead><tr><th>Order</th><th>Customer</th><th>Pincode</th><th>Payment</th></tr></thead><tbody>
      <% latestOrders.forEach((order) => { %>
        <tr><td><%= order.orderNumber %></td><td><%= order.customerName %></td><td><%= order.pincode %></td><td><%= order.paymentMode %></td></tr>
      <% }) %>
    </tbody></table>
  </main>
</body></html>
