<!doctype html>
<html>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Create Manual Order</title>
  <link rel="stylesheet" href="/public/css/main.css" />
</head>
<body>
  <div class="app-shell">
    <%- include('partials/_nav', { activePage: 'orders' }) %>

    <div class="app-content">
      <header class="topbar topbar-actions">
        <button class="sidebar-toggle" type="button" aria-label="Toggle sidebar" onclick="document.body.classList.toggle('sidebar-open')">☰</button>
        <div>
          <p class="page-eyebrow">Orders</p>
          <h1>Create Manual Order</h1>
        </div>
        <div class="topbar-btn-row">
          <a class="btn btn-soft-link" href="/orders">Dismiss</a>
          <button class="btn btn-soft" type="button" data-save-mode="save">Save</button>
          <button class="btn" type="button" data-save-mode="create_and_assign">Save &amp; Assign Courier</button>
        </div>
      </header>

      <main class="container manual-order-page">
        <section class="card manual-order-hero">
          <div>
            <p class="page-eyebrow">Provider-agnostic workflow</p>
            <h2>Normalized manual order creation</h2>
            <p class="muted small">Single shared workflow for Delhivery Direct, Shipmozo, and future providers with dynamic rules and validation.</p>
          </div>
          <div class="manual-order-top-grid">
            <label>
              Provider
              <select data-field="provider_target" id="providerTarget"></select>
            </label>
            <label>
              Shipment Type
              <select data-field="shipment_type" id="shipmentType">
                <option value="B2C">B2C</option>
                <option value="B2B">B2B</option>
              </select>
            </label>
            <label>
              Order Source
              <input value="Manual" disabled />
            </label>
          </div>
        </section>

        <section class="card">
          <div class="section-header">
            <h3>A. Buyer / Receiver Details</h3>
          </div>
          <div class="manual-grid-3 buyer-grid">
            <label>Buyer / Receiver Name<input data-field="buyer_details.contact_name" /></label>
            <label>Phone<input data-field="buyer_details.phone" /></label>
            <label>Email<input data-field="buyer_details.email" /></label>
            <label>GSTIN<input data-field="buyer_details.gstin" /></label>
            <label>Pincode<input data-field="buyer_details.pincode" maxlength="6" /></label>
            <label>City<input data-field="buyer_details.city" /></label>
            <label>State<input data-field="buyer_details.state" /></label>
            <label class="manual-grid-span-2">Address Line 1<input data-field="buyer_details.address_line_1" /></label>
            <label class="manual-grid-span-3">Address Line 2<input data-field="buyer_details.address_line_2" /></label>
          </div>
        </section>

        <section class="card">
          <div class="section-header">
            <h3>B. Order Details</h3>
          </div>
          <div class="manual-grid-4 order-meta-grid">
            <label>Order ID<input data-field="order_id" /></label>
            <label>Order Date<input data-field="order_date" type="date" /></label>
            <label>Reference ID<input data-field="reference_id" /></label>
            <label>Payment Type
              <select data-field="payment_mode">
                <option value="PREPAID">Prepaid</option>
                <option value="COD">COD</option>
              </select>
            </label>
          </div>
          <div class="line-items-head">
            <h4>Line Items</h4>
            <button class="btn btn-sm btn-soft" type="button" id="addLineItemBtn">Add Item</button>
          </div>
          <div class="line-items-wrap" id="lineItemsWrap"></div>
          <div class="order-total-row">
            <label class="grand-total-field">Grand Total<input id="grandTotal" disabled /></label>
          </div>
        </section>

        <section class="card">
          <div class="section-header">
            <h3>C. Warehouse / Pickup Address</h3>
            <a class="btn btn-sm btn-soft-link" href="/warehouse">Manage Warehouses</a>
          </div>
          <div class="pickup-cards" id="pickupCards"></div>
        </section>

        <section class="card">
          <div class="section-header">
            <h3>D. Weight &amp; Dimensions</h3>
          </div>
          <div class="manual-grid-3 metrics-grid">
            <label>Package Type
              <select data-field="package_mode" id="packageMode">
                <option value="SINGLE_PACKAGE_B2C">Single Package (B2C)</option>
                <option value="MULTI_PACKAGE_B2B">Multiple Package (B2B)</option>
              </select>
            </label>
            <div class="card-soft package-metric">
              <p class="muted small">Total boxes</p>
              <p><strong id="totalBoxes">1</strong></p>
            </div>
            <div class="card-soft package-metric">
              <p class="muted small">Total shipment weight</p>
              <p><strong id="totalWeight">0.5 kg</strong></p>
            </div>
          </div>
          <div class="line-items-head">
            <h4>Package Rows</h4>
            <button class="btn btn-sm btn-soft" type="button" id="addPackageRowBtn">Add Package Group</button>
          </div>
          <div class="package-rows-wrap" id="packageRowsWrap"></div>
        </section>

        <section class="card">
          <div class="section-header">
            <h3>E. Other Details / Documents</h3>
          </div>
          <div class="manual-grid-3 docs-grid" id="dynamicDocsSection"></div>
        </section>

        <section class="card validation-card" id="validationSummaryCard" hidden>
          <h3>Validation summary</h3>
          <ul id="validationSummaryList"></ul>
        </section>

        <section class="manual-sticky-footer">
          <a class="btn btn-soft-link" href="/orders">Dismiss</a>
          <button class="btn btn-soft" type="button" data-save-mode="save">Save</button>
          <button class="btn" type="button" data-save-mode="create_and_assign">Save &amp; Assign Courier</button>
        </section>
      </main>
    </div>
  </div>

  <script>
    (() => {
      const initialDraft = <%- JSON.stringify(manualOrderDraft) %>;
      const providerOptions = <%- JSON.stringify(providerOptions) %>;
      const pickupAddresses = <%- JSON.stringify(pickupAddresses) %>;
      const providerCapabilities = <%- JSON.stringify(providerCapabilities) %>;
      const manualOrderRules = <%- JSON.stringify(manualOrderRules) %>;
      const pincodeDirectory = <%- JSON.stringify(pincodeDirectory) %>;
      const PACKAGE_MODE = {
        SINGLE: 'SINGLE_PACKAGE_B2C',
        MULTI: 'MULTI_PACKAGE_B2B'
      };

      const state = {
        draft: JSON.parse(localStorage.getItem('manual_order_draft') || 'null') || initialDraft,
        savedDrafts: JSON.parse(localStorage.getItem('manual_order_saved_records') || '[]')
      };

      const fieldErrorMap = {
        buyer_name: 'buyer_details.contact_name',
        buyer_phone: 'buyer_details.phone',
        buyer_pincode: 'buyer_details.pincode',
        order_id: 'order_id',
        invoice_number: 'invoice_number',
        invoice_amount: 'invoice_amount',
        shipping_mode: 'shipping_mode'
      };

      const providerTarget = document.getElementById('providerTarget');
      const shipmentType = document.getElementById('shipmentType');
      const packageMode = document.getElementById('packageMode');
      const lineItemsWrap = document.getElementById('lineItemsWrap');
      const packageRowsWrap = document.getElementById('packageRowsWrap');
      const pickupCards = document.getElementById('pickupCards');
      const dynamicDocsSection = document.getElementById('dynamicDocsSection');
      const totalBoxes = document.getElementById('totalBoxes');
      const totalWeight = document.getElementById('totalWeight');
      const grandTotal = document.getElementById('grandTotal');
      const validationSummaryCard = document.getElementById('validationSummaryCard');
      const validationSummaryList = document.getElementById('validationSummaryList');

      const setByPath = (obj, path, value) => {
        const keys = path.split('.');
        let pointer = obj;
        keys.forEach((key, index) => {
          if (index === keys.length - 1) {
            pointer[key] = value;
          } else {
            pointer[key] = pointer[key] || {};
            pointer = pointer[key];
          }
        });
      };

      const getByPath = (obj, path) => path.split('.').reduce((acc, key) => (acc ? acc[key] : undefined), obj);
      const toNumber = (value) => Number(value || 0);
      const uid = () => Math.random().toString(36).slice(2, 10);

      const calculateManualOrderGrandTotal = () => Number(state.draft.line_items
        .reduce((sum, item) => sum + (toNumber(item.quantity) * toNumber(item.unit_price)), 0)
        .toFixed(2));

      const shouldShowEwayBill = (visibleFields) => {
        const grandTotalAmount = calculateManualOrderGrandTotal();
        return grandTotalAmount > manualOrderRules.ewayBillAutoThreshold || visibleFields.includes('eway_bill_number');
      };

      const lookupIndianPincode = async (pincode) => {
        const normalized = String(pincode || '').trim();
        if (!/^\d{6}$/.test(normalized)) {
          return null;
        }
        return pincodeDirectory[normalized] || null;
      };

      const applyPincodeLookup = async (pincode) => {
        const lookup = await lookupIndianPincode(pincode);
        if (!lookup) {
          return;
        }

        state.draft.buyer_details.city = lookup.city;
        state.draft.buyer_details.state = lookup.state;
      };

      const getRules = () => {
        const provider = providerCapabilities[state.draft.provider_target];
        return provider.field_rules[state.draft.shipment_type];
      };

      const getDocumentFieldsForRender = () => {
        const rules = getRules();
        const visibleFieldSet = new Set(rules.visible);
        const ewayFields = ['eway_bill_number', 'eway_bill_document'];

        if (shouldShowEwayBill(rules.visible)) {
          ewayFields.forEach((fieldName) => visibleFieldSet.add(fieldName));
        } else {
          ewayFields.forEach((fieldName) => {
            if (!rules.visible.includes(fieldName)) {
              visibleFieldSet.delete(fieldName);
            }
          });
        }

        return Array.from(visibleFieldSet);
      };

      const computeTotals = () => {
        const totalShipmentWeight = state.draft.package_rows.reduce((sum, row) => sum + (toNumber(row.no_of_boxes) * toNumber(row.per_box_weight_kg)), 0);
        const boxes = state.draft.package_rows.reduce((sum, row) => sum + toNumber(row.no_of_boxes), 0);
        const lineItemsTotal = calculateManualOrderGrandTotal();

        state.draft.total_weight = Number(totalShipmentWeight.toFixed(2));
        state.draft.invoice_amount = lineItemsTotal;

        totalBoxes.textContent = String(boxes || 0);
        totalWeight.textContent = `${state.draft.total_weight.toFixed(2)} kg`;
        grandTotal.value = `₹${lineItemsTotal.toFixed(2)}`;
      };

      const validateDraft = () => {
        const rules = getRules();
        const errors = {};

        if (!state.draft.buyer_details.contact_name.trim()) errors.buyer_name = 'Buyer/receiver name is required';
        if (!state.draft.buyer_details.phone.trim()) errors.buyer_phone = 'Phone number is required';
        if (!state.draft.buyer_details.pincode.trim()) errors.buyer_pincode = 'Pincode is required';
        if (!state.draft.order_id.trim()) errors.order_id = 'Order ID is required';

        if (!state.draft.line_items.length || !state.draft.line_items[0].product_name.trim()) {
          errors.line_items = 'At least one product line item is required';
        }

        if (!state.draft.package_rows.length) {
          errors.package_rows = 'At least one package row is required';
        }

        if (rules.required.includes('invoice_number') && !state.draft.invoice_number.trim()) {
          errors.invoice_number = 'Invoice number is required';
        }
        if (rules.required.includes('invoice_amount') && toNumber(state.draft.invoice_amount) <= 0) {
          errors.invoice_amount = 'Invoice amount should be greater than 0';
        }
        if (rules.required.includes('invoice_document') && !state.draft.invoice_document) {
          errors.invoice_document = 'Invoice document upload is required';
        }
        if (rules.required.includes('shipping_mode') && !state.draft.shipping_mode.trim()) {
          errors.shipping_mode = 'Shipping mode is required';
        }

        state.draft.validation_state = { is_valid: !Object.keys(errors).length, errors };
        return errors;
      };

      const renderValidation = () => {
        const errors = state.draft.validation_state.errors;
        const keys = Object.keys(errors);

        document.querySelectorAll('.field-error').forEach((node) => node.remove());
        if (!keys.length) {
          validationSummaryCard.hidden = true;
          return;
        }

        validationSummaryCard.hidden = false;
        validationSummaryList.innerHTML = keys.map((key) => `<li>${errors[key]}</li>`).join('');

        keys.forEach((key) => {
          const mapped = fieldErrorMap[key] || key;
          const field = document.querySelector(`[data-field="${mapped}"]`);
          if (!field) return;
          const error = document.createElement('p');
          error.className = 'field-error';
          error.textContent = errors[key];
          field.closest('label')?.appendChild(error);
        });
      };

      const renderLineItems = () => {
        lineItemsWrap.innerHTML = '';
        state.draft.line_items.forEach((item, index) => {
          const row = document.createElement('div');
          row.className = 'line-item-row';
          row.innerHTML = `
            <label>Product Name<input data-line-index="${index}" data-line-key="product_name" value="${item.product_name || ''}" /></label>
            <label>SKU<input data-line-index="${index}" data-line-key="sku" value="${item.sku || ''}" /></label>
            <label>HSN<input data-line-index="${index}" data-line-key="hsn" value="${item.hsn || ''}" /></label>
            <label>Qty<input type="number" min="1" data-line-index="${index}" data-line-key="quantity" value="${item.quantity || 1}" /></label>
            <label>Unit Price<input type="number" min="0" step="0.01" data-line-index="${index}" data-line-key="unit_price" value="${item.unit_price || 0}" /></label>
            <div class="row-action-wrap">
              <button class="icon-btn" type="button" aria-label="Remove item" data-remove-line="${index}" ${state.draft.line_items.length === 1 ? 'disabled' : ''}>✕</button>
            </div>
          `;
          lineItemsWrap.appendChild(row);
        });
      };

      const renderPackageRows = () => {
        packageRowsWrap.innerHTML = '';
        state.draft.package_rows.forEach((row, index) => {
          const item = document.createElement('div');
          item.className = 'package-row';
          item.innerHTML = `
            <label>No. of boxes<input type="number" min="1" data-package-index="${index}" data-package-key="no_of_boxes" value="${row.no_of_boxes}" /></label>
            <label>Weight / box (kg)<input type="number" min="0.1" step="0.1" data-package-index="${index}" data-package-key="per_box_weight_kg" value="${row.per_box_weight_kg}" /></label>
            <label>Length (cm)<input type="number" min="1" data-package-index="${index}" data-package-key="length_cm" value="${row.length_cm}" /></label>
            <label>Width (cm)<input type="number" min="1" data-package-index="${index}" data-package-key="width_cm" value="${row.width_cm}" /></label>
            <label>Height (cm)<input type="number" min="1" data-package-index="${index}" data-package-key="height_cm" value="${row.height_cm}" /></label>
            <div class="row-action-wrap">
              <button class="icon-btn" type="button" aria-label="Remove package row" data-remove-package="${index}" ${state.draft.package_rows.length === 1 ? 'disabled' : ''}>✕</button>
            </div>
          `;
          packageRowsWrap.appendChild(item);
        });
      };

      const renderPickupCards = () => {
        pickupCards.innerHTML = pickupAddresses.map((pickup) => `
          <label class="pickup-card ${state.draft.warehouse_or_pickup_address.selected_pickup_id === pickup.id ? 'is-selected' : ''}">
            <input type="radio" name="pickup" value="${pickup.id}" ${state.draft.warehouse_or_pickup_address.selected_pickup_id === pickup.id ? 'checked' : ''} />
            <div>
              <strong>${pickup.name}</strong>
              <p class="muted small">${pickup.contact_person_name} · ${pickup.phone}</p>
              <p class="muted small">${pickup.address}</p>
              <p class="muted small">Pincode: ${pickup.pincode}</p>
            </div>
          </label>
        `).join('');
      };

      const renderDynamicDocs = () => {
        const visibleFields = getDocumentFieldsForRender();
        const fields = {
          invoice_number: '<label>Invoice Number<input data-field="invoice_number" /></label>',
          invoice_amount: '<label>Invoice Amount<input type="number" step="0.01" data-field="invoice_amount" /></label>',
          invoice_document: '<label>Invoice Document<input type="file" data-upload-field="invoice_document" /></label>',
          eway_bill_number: '<label>E-Way Bill Number<input data-field="eway_bill_number" /></label>',
          eway_bill_document: '<label>E-Way Bill Document<input type="file" data-upload-field="eway_bill_document" /></label>',
          secondary_document: '<label>Secondary Document<input type="file" data-upload-field="secondary_document" /></label>',
          gstin: '<label>GSTIN<input data-field="gstin" /></label>',
          transporter_id: '<label>Transporter ID<input data-field="transporter_id" /></label>',
          shipping_mode: '<label>Shipping Mode<select data-field="shipping_mode"><option>Surface</option><option>Air</option><option>Express</option></select></label>'
        };

        dynamicDocsSection.innerHTML = visibleFields.map((fieldName) => fields[fieldName] || '').join('');
      };

      const syncPrimitiveFields = () => {
        document.querySelectorAll('[data-field]').forEach((node) => {
          const path = node.dataset.field;
          const value = getByPath(state.draft, path);
          if (node.tagName === 'SELECT') {
            node.value = value || node.value;
          } else if (!node.disabled) {
            node.value = value ?? '';
          }
        });
      };

      const persistDraft = () => {
        localStorage.setItem('manual_order_draft', JSON.stringify(state.draft));
      };

      const persistSavedRecords = () => {
        localStorage.setItem('manual_order_saved_records', JSON.stringify(state.savedDrafts));
      };

      const saveManualOrderDraft = () => {
        const savedAt = new Date().toISOString();
        state.draft.save_mode = 'save';
        persistDraft();

        state.savedDrafts = [
          {
            order_id: state.draft.order_id,
            provider_target: state.draft.provider_target,
            shipment_type: state.draft.shipment_type,
            grand_total: calculateManualOrderGrandTotal(),
            saved_at: savedAt
          },
          ...state.savedDrafts.filter((entry) => entry.order_id !== state.draft.order_id)
        ].slice(0, 25);

        persistSavedRecords();
        return 'Manual order saved in shared mock state.';
      };

      const createManualOrder = () => {
        state.draft.save_mode = 'create';
        persistDraft();
        return 'Manual order created successfully (mock).';
      };

      const saveAndAssignCourier = () => {
        state.draft.save_mode = 'create_and_assign';
        persistDraft();
        return 'Manual order saved and courier assignment queued (mock).';
      };

      const redraw = () => {
        renderLineItems();
        renderPackageRows();
        renderPickupCards();
        renderDynamicDocs();
        syncPrimitiveFields();
        computeTotals();
        renderValidation();
      };

      providerOptions.forEach((provider) => {
        const option = document.createElement('option');
        option.value = provider.value;
        option.textContent = provider.label;
        providerTarget.appendChild(option);
      });

      document.getElementById('addLineItemBtn').addEventListener('click', () => {
        state.draft.line_items.push({ id: uid(), product_name: '', sku: '', hsn: '', category: '', quantity: 1, unit_price: 0, tax_percent: 0 });
        persistDraft();
        redraw();
      });

      document.getElementById('addPackageRowBtn').addEventListener('click', () => {
        if (state.draft.package_mode === PACKAGE_MODE.SINGLE) return;
        state.draft.package_rows.push({ id: uid(), no_of_boxes: 1, per_box_weight_kg: 0.5, length_cm: 20, width_cm: 14, height_cm: 7 });
        persistDraft();
        redraw();
      });

      document.addEventListener('input', async (event) => {
        const target = event.target;
        if (!(target instanceof HTMLElement)) return;

        if (target.matches('[data-field]')) {
          const path = target.dataset.field;
          const value = target.type === 'number' ? toNumber(target.value) : target.value;
          setByPath(state.draft, path, value);

          if (path === 'shipment_type') {
            state.draft.package_mode = target.value === 'B2B' ? PACKAGE_MODE.MULTI : PACKAGE_MODE.SINGLE;
            if (state.draft.package_mode === PACKAGE_MODE.SINGLE) {
              state.draft.package_rows = [state.draft.package_rows[0]];
            }
          }

          if (path === 'buyer_details.pincode') {
            await applyPincodeLookup(value);
          }

          validateDraft();
          persistDraft();
          redraw();
          return;
        }

        if (target.matches('[data-line-key]')) {
          const index = Number(target.dataset.lineIndex);
          const key = target.dataset.lineKey;
          const value = target.type === 'number' ? toNumber(target.value) : target.value;
          state.draft.line_items[index][key] = value;
          validateDraft();
          persistDraft();
          computeTotals();
          renderDynamicDocs();
          return;
        }

        if (target.matches('[data-package-key]')) {
          const index = Number(target.dataset.packageIndex);
          const key = target.dataset.packageKey;
          state.draft.package_rows[index][key] = toNumber(target.value);
          validateDraft();
          persistDraft();
          computeTotals();
          return;
        }

        if (target.matches('input[name="pickup"]')) {
          state.draft.warehouse_or_pickup_address.selected_pickup_id = target.value;
          persistDraft();
          redraw();
        }
      });

      document.addEventListener('change', (event) => {
        const target = event.target;
        if (!(target instanceof HTMLElement)) return;

        if (target.matches('[data-upload-field]')) {
          const field = target.dataset.uploadField;
          const file = target.files && target.files[0];
          if (file) {
            state.draft[field] = {
              id: uid(),
              file_name: file.name,
              file_size: file.size,
              uploaded_at: new Date().toISOString()
            };
          } else {
            state.draft[field] = null;
          }
          validateDraft();
          persistDraft();
          redraw();
        }
      });

      document.addEventListener('click', (event) => {
        const target = event.target;
        if (!(target instanceof HTMLElement)) return;

        if (target.matches('[data-remove-line]')) {
          const index = Number(target.dataset.removeLine);
          state.draft.line_items.splice(index, 1);
          validateDraft();
          persistDraft();
          redraw();
          return;
        }

        if (target.matches('[data-remove-package]')) {
          const index = Number(target.dataset.removePackage);
          state.draft.package_rows.splice(index, 1);
          validateDraft();
          persistDraft();
          redraw();
          return;
        }

        if (target.matches('[data-save-mode]')) {
          const mode = target.dataset.saveMode;
          const errors = validateDraft();
          persistDraft();
          redraw();

          if (mode !== 'save' && Object.keys(errors).length) {
            return;
          }

          const actionByMode = {
            save: saveManualOrderDraft,
            create: createManualOrder,
            create_and_assign: saveAndAssignCourier
          };

          const action = actionByMode[mode] || saveManualOrderDraft;
          alert(action());
        }
      });

      state.draft.provider_target = state.draft.provider_target || providerOptions[0].value;
      state.draft.shipping_zone = manualOrderRules.defaultShippingZone;
      if (!state.draft.warehouse_or_pickup_address.selected_pickup_id && pickupAddresses.length) {
        state.draft.warehouse_or_pickup_address.selected_pickup_id = pickupAddresses[0].id;
      }
      providerTarget.value = state.draft.provider_target;
      shipmentType.value = state.draft.shipment_type;
      packageMode.value = state.draft.package_mode;

      validateDraft();
      redraw();
    })();
  </script>
</body>
</html>
