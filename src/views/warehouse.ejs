<!doctype html>
<html>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Warehouses</title>
  <link rel="stylesheet" href="/public/css/main.css" />
</head>
<body>
  <div class="app-shell">
    <%- include('partials/_nav', { activePage: 'warehouse' }) %>

    <div class="app-content">
      <header class="topbar topbar-actions">
        <button class="sidebar-toggle" type="button" aria-label="Toggle sidebar" onclick="document.body.classList.toggle('sidebar-open')">☰</button>
        <div>
          <p class="page-eyebrow">Operations</p>
          <h1>Warehouse</h1>
        </div>
      </header>

      <main class="container warehouse-page">
        <section class="card warehouse-layout">
          <div class="section-header">
            <h3>Manage pickup warehouses</h3>
          </div>
          <p class="muted">Shared mock warehouse source for Manual Order pickup selection. Ready to swap with backend persistence later.</p>

          <div class="table-wrap warehouse-table-wrap">
            <table>
              <thead>
                <tr>
                  <th>Warehouse</th>
                  <th>Contact Person</th>
                  <th>Phone</th>
                  <th>Address</th>
                  <th>Pincode</th>
                  <th>Actions</th>
                </tr>
              </thead>
              <tbody>
                <% warehouses.forEach((warehouse) => { %>
                  <tr>
                    <td><strong><%= warehouse.name %></strong></td>
                    <td><%= warehouse.contact_person_name %></td>
                    <td><%= warehouse.phone %></td>
                    <td><%= warehouse.address %></td>
                    <td><%= warehouse.pincode %></td>
                    <td>
                      <div class="warehouse-row-actions">
                        <a class="btn btn-sm btn-soft-link" href="/warehouse?edit=<%= warehouse.id %>">Edit</a>
                        <form method="post" action="/warehouse/<%= warehouse.id %>/delete" onsubmit="return confirm('Delete this warehouse?');">
                          <button class="btn btn-sm warehouse-delete-btn" type="submit">Delete</button>
                        </form>
                      </div>
                    </td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        </section>

        <section class="card warehouse-form-card">
          <div class="section-header">
            <h3><%= editWarehouse ? 'Edit warehouse' : 'Add warehouse' %></h3>
          </div>
          <form method="post" action="/warehouse" class="warehouse-form-grid">
            <input type="hidden" name="id" value="<%= editWarehouse?.id ?? '' %>" />
            <label>Warehouse Name<input name="name" required value="<%= editWarehouse?.name ?? '' %>" /></label>
            <label>Contact Person Name<input name="contact_person_name" required value="<%= editWarehouse?.contact_person_name ?? '' %>" /></label>
            <label>Phone Number<input name="phone" required value="<%= editWarehouse?.phone ?? '' %>" /></label>
            <label>Address<input name="address" required value="<%= editWarehouse?.address ?? '' %>" /></label>
            <label>Pincode<input name="pincode" required value="<%= editWarehouse?.pincode ?? '' %>" /></label>
            <div class="warehouse-form-actions">
              <% if (editWarehouse) { %>
                <a class="btn btn-soft-link" href="/warehouse">Cancel edit</a>
              <% } %>
              <button class="btn" type="submit"><%= editWarehouse ? 'Update Warehouse' : 'Add Warehouse' %></button>
            </div>
          </form>
        </section>
      </main>
    </div>
  </div>
</body>
</html>
