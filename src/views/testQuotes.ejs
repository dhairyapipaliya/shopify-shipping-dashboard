<!doctype html>
<html>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Test Quotes</title>
  <link rel="stylesheet" href="/public/css/main.css" />
</head>
<body>
  <div class="app-shell">
    <%- include('partials/_nav', { activePage: 'testQuotes' }) %>

    <div class="app-content">
      <header class="topbar">
        <button class="sidebar-toggle" type="button" aria-label="Toggle sidebar" onclick="document.body.classList.toggle('sidebar-open')">☰</button>
        <div>
          <p class="page-eyebrow">Sandbox</p>
          <h1>Quote Test</h1>
        </div>
      </header>

      <main class="container">
        <section class="card">
          <p>Compare Delhivery Direct vs Shipmozo Delhivery by cost only.</p>
        </section>

        <form method="post" action="/admin/test-quotes" class="card form-grid">
          <label>Destination Pincode <input name="destinationPincode" required value="<%= form.destinationPincode %>" /></label>
          <label>Weight (grams) <input name="weightGrams" type="number" min="1" required value="<%= form.weightGrams %>" /></label>
          <label>Length (cm) <input name="lengthCm" type="number" min="1" required value="<%= form.lengthCm %>" /></label>
          <label>Width (cm) <input name="widthCm" type="number" min="1" required value="<%= form.widthCm %>" /></label>
          <label>Height (cm) <input name="heightCm" type="number" min="1" required value="<%= form.heightCm %>" /></label>
          <label>Payment Mode
            <select name="paymentMode">
              <option value="PREPAID" <%= form.paymentMode === 'PREPAID' ? 'selected' : '' %>>Prepaid</option>
              <option value="COD" <%= form.paymentMode === 'COD' ? 'selected' : '' %>>COD</option>
            </select>
          </label>
          <label>Order Value (₹) <input name="orderValue" type="number" min="0" required value="<%= form.orderValue %>" /></label>
          <div>
            <button class="btn" type="submit">Test Comparison</button>
          </div>
        </form>

        <% if (result) { %>
          <section class="card">
            <div class="section-header">
              <h3>Cheapest Option</h3>
              <span class="badge badge-green">Recommendation</span>
            </div>
            <p><strong><%= result.cheapest ? result.cheapest.serviceName : 'N/A' %></strong></p>
            <p class="muted">Savings: ₹<%= result.savingsAmount %></p>
          </section>

          <section class="card">
            <div class="table-wrap">
              <table>
                <thead><tr><th>Provider</th><th>Service</th><th>Shipping</th><th>COD</th><th>Total</th></tr></thead>
                <tbody>
                  <% result.ranked.forEach((q) => { %>
                    <tr>
                      <td><%= q.provider %></td>
                      <td><%= q.serviceName %></td>
                      <td>₹<%= q.shippingCost %></td>
                      <td>₹<%= q.codCharges %></td>
                      <td><strong>₹<%= q.totalCost %></strong></td>
                    </tr>
                  <% }) %>
                </tbody>
              </table>
            </div>
          </section>
        <% } %>
      </main>
    </div>
  </div>
</body>
</html>
