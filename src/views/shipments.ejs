<!doctype html>
<html>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Shipments</title>
  <link rel="stylesheet" href="/public/css/main.css" />
</head>
<body>
  <div class="app-shell">
    <%- include('partials/_nav', { activePage: 'shipments' }) %>

    <div class="app-content">
      <header class="topbar">
        <button class="sidebar-toggle" type="button" aria-label="Toggle sidebar" onclick="document.body.classList.toggle('sidebar-open')">☰</button>
        <div>
          <p class="page-eyebrow">Logistics</p>
          <h1>Shipments</h1>
        </div>
      </header>

      <main class="container">
        <section class="card">
          <div class="table-wrap">
            <table>
              <thead><tr><th>Order</th><th>Provider</th><th>Service</th><th>AWB</th><th>Label</th><th>Tracking</th><th>Status</th></tr></thead>
              <tbody>
                <% const renderedRows = new Set(); %>
                <% shipments.forEach((s) => { %>
                  <% const dedupeKey = `${s.orderId}:${s.id}`; %>
                  <% if (renderedRows.has(dedupeKey)) { return; } %>
                  <% renderedRows.add(dedupeKey); %>
                  <tr>
                    <td><%= s.order.orderNumber %></td>
                    <td><%= s.provider %></td>
                    <td><%= s.serviceName %></td>
                    <td><%= s.awbNumber || '-' %></td>
                    <td>
                      <% if (s.labelUrl) { %>
                        <a class="link" href="<%= s.labelUrl %>" target="_blank" rel="noreferrer">Download Label</a>
                      <% } else { %>
                        -
                      <% } %>
                    </td>
                    <td>
                      <% if (s.trackingUrl) { %>
                        <a class="link" href="<%= s.trackingUrl %>" target="_blank" rel="noreferrer">Track</a>
                      <% } else { %>
                        -
                      <% } %>
                    </td>
                    <td><span class="badge badge-blue"><%= s.status %></span></td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        </section>
      </main>
    </div>
  </div>
</body>
</html>
