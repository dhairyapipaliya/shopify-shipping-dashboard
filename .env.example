# App
NODE_ENV=development
PORT=3000
APP_BASE_URL=http://localhost:3000
SESSION_SECRET=replace_with_long_random_secret

# PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/shopify_shipping_dashboard?schema=public

# Admin bootstrap user
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe123!

# Shopify (sandbox/test app)
SHOPIFY_SHOP_DOMAIN=your-dev-store.myshopify.com
SHOPIFY_ACCESS_TOKEN=shpat_xxx
SHOPIFY_API_VERSION=2025-10
SHOPIFY_USE_MOCK_DATA=true

# Delhivery Direct (sandbox)
DELHIVERY_BASE_URL=https://staging-express.delhivery.com
DELHIVERY_API_KEY=delhivery_sandbox_api_key
DELHIVERY_USE_MOCK=true

# Shipmozo (sandbox)
SHIPMOZO_BASE_URL=https://sandbox.shipmozo.example
SHIPMOZO_API_KEY=shipmozo_sandbox_api_key
SHIPMOZO_USE_MOCK=true
